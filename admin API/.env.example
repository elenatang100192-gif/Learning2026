# ============================================
# 服务器配置
# ============================================
# 服务器端口（默认：3001）
PORT=3001

# 运行环境：development | production
NODE_ENV=development

# ============================================
# MySQL数据库配置（必需）
# ============================================
# 数据库主机地址
DB_HOSTNAME=your_database_host_here

# 数据库端口（默认：3306）
DB_PORT=3306

# 数据库用户名
DB_USERNAME=your_database_username_here

# 数据库密码
DB_PASSWORD=your_database_password_here

# 数据库名称
DB_DATABASE=your_database_name_here

# ============================================
# 七牛云存储配置（必需）
# ============================================
# 七牛云自定义域名（完整URL，包含协议，如：https://trainspace.ashgso.com）
QINIU_URL=https://your-qiniu-domain.com

# 七牛云存储空间名称
QINIU_BUCKET=your_qiniu_bucket_name_here

# 七牛云Access Key
QINIU_ACCESS_KEY=your_qiniu_access_key_here

# 七牛云Secret Key
QINIU_SECRET_KEY=your_qiniu_secret_key_here

# ============================================
# 邮件服务配置（用于发送OTP验证码）
# ============================================
# SMTP服务器地址（可选，会根据邮箱域名自动识别）
EMAIL_HOST=smtp.gmail.com

# SMTP端口（默认：587）
EMAIL_PORT=587

# 是否使用SSL/TLS（true/false，端口465通常为true）
EMAIL_SECURE=false

# 发件人邮箱地址
EMAIL_USER=your_email@example.com

# 发件人邮箱密码或应用专用密码
EMAIL_PASS=your_email_password_here

# 备用配置项（如果上面的配置不生效，可以使用这些）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_password_here
# EMAIL_PASSWORD=your_email_password_here

# ============================================
# CORS跨域配置（生产环境）
# ============================================
# 前端应用URL（用于CORS配置）
FRONTEND_URL=https://your-frontend-domain.com

# 后台管理URL（用于CORS配置）
ADMIN_URL=https://your-admin-domain.com

# ============================================
# AI API配置（可选，用于视频生成等功能）
# ============================================
# 阿里云百炼（DashScope）API配置
# 获取方式：https://bailian.console.aliyun.com/?tab=api#/api/?type=model&url=2803795
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 阿里云API Key（备用）
ALIYUN_API_KEY=your_aliyun_api_key_here

# OpenAI API配置（Azure OpenAI）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENDPOINT=your_openai_endpoint_here
OPENAI_DEPLOYMENT_NAME=your_deployment_name_here
OPENAI_API_VERSION=2025-04-01-preview

# Azure OpenAI配置（备用）
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
AZURE_OPENAI_DEPLOYMENT_NAME=your_azure_deployment_name_here

# 豆包（字节跳动）API配置
DOUBAO_IMAGE_MODEL_ID=your_doubao_image_model_id_here
